function %cvt(i32) -> i32 {
block0(v9: i32):
    v0 = vconst.i32x4 [0x3fc00000 0x7fc00000 0x50000000 0xc0200000]
    v1 = bitcast.f32x4 little v0
    v2 = x86_cvtt2dq.i32x4 v1
    v3 = extractlane.i32x4 v2, 0
    v4 = extractlane.i32x4 v2, 1
    v5 = extractlane.i32x4 v2, 2
    v6 = extractlane.i32x4 v2, 3
